// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(uuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  username      String?      @unique
  displayName   String?
  bio           String?
  // bcrypt hash for the email + password sign-up path. Null for users who
  // came in via Google OAuth (or any other future provider).
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  experiences   Experience[]
  entries       Entry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ExperienceType {
  JOB
  EDUCATION
  PROJECT
  VOLUNTEER
  BREAK
}

model Experience {
  id           String         @id @default(uuid())
  type         ExperienceType @default(JOB)
  // The language the user originally wrote in. Used as the canonical source
  // for AI translation and to decide which translation to fall back to when
  // the requested locale is missing.
  primaryLocale String         @default("en")
  startDate    DateTime
  endDate      DateTime?
  color        String         @default("blue")
  entries      Entry[]
  translations ExperienceTranslation[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// One row per (experience, locale). Contains every text field that varies by
// language. organization + role moved here from Experience; non-translatable
// fields (dates, type, color) stay on the parent.
model ExperienceTranslation {
  id           String     @id @default(uuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  locale       String     // 'en' | 'zh-TW' — kept as String so new locales don't require a migration

  organization String
  role         String?
  description  String?

  // Hash of the *primary-locale* translation fields at the time this row was
  // last generated / verified. When the primary row is edited, this hash goes
  // stale and the UI shows a "needs re-translation" indicator.
  sourceHash      String?
  lastTranslatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([experienceId, locale])
  @@index([locale])
}

model Entry {
  id            String      @id @default(uuid())
  date          DateTime
  // See Experience.primaryLocale.
  primaryLocale String      @default("en")
  // Curation flag used by the résumé builder's "featured only" filter.
  // Lets the user keep rough notes in the timeline without polluting their
  // résumé output.
  featured      Boolean     @default(false)
  // Cross-locale stable identifier for the tag — UI labels can differ per
  // language but resume sectioning, filtering, and badge colour all key off
  // this slug. Generated from the primary-locale tag at write time.
  tagSlug       String
  color         String
  techStack     String[]
  linkUrl       String?
  linkText      String?
  iconId        String?
  icon          Icon?       @relation(fields: [iconId], references: [id])
  experienceId  String?
  experience    Experience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  translations  EntryTranslation[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([tagSlug])
}

// One row per (entry, locale). All language-varying text lives here.
model EntryTranslation {
  id          String @id @default(uuid())
  entryId     String
  entry       Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  locale      String // 'en' | 'zh-TW'

  title       String
  actionVerb  String?
  description String
  impact      String?
  details     String?
  // Display label for the tag in this locale (e.g. "Engineering" / "工程").
  // Cross-locale key is on Entry.tagSlug.
  tag         String

  sourceHash       String?
  lastTranslatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entryId, locale])
  @@index([locale])
}

model Icon {
  id      String  @id @default(uuid())
  name    String  @unique // Lucide icon name (e.g., "GraduationCap")
  entries Entry[]
}
