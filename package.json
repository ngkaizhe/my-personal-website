{
  "name": "my-personal-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate:icons": "node scripts/generate-icon-names.js",
    "postinstall": "prisma generate && npm run generate:icons",
    "db:push": "dotenv -e .env.local -- prisma db push --accept-data-loss",
    "db:reset": "dotenv -e .env.local -- prisma db push --force-reset && npm run db:seed",
    "db:seed": "dotenv -e .env.local -- prisma db seed",
    "db:studio": "dotenv -e .env.local -- prisma studio --browser none"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@auth/prisma-adapter": "^2.11.2",
    "bcryptjs": "^3.0.2",
    "@prisma/client": "^6.19.2",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.0.0",
    "eslint-config-next": "^16.1.6",
    "lightningcss": "^1.32.0",
    "lucide-react": "^0.564.0",
    "motion": "^12.34.0",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.0.0",
    "prisma": "^6.19.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.3.9",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/styled-components": "^5.1.26",
    "autoprefixer": "^10.4.24",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
