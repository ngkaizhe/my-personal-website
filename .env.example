# ============================================================
# Environment variables for local development
# ============================================================
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored; never commit real secrets.
#
#   cp .env.example .env.local
#
# Production secrets belong in your deploy platform (Vercel /
# Railway / etc.), not this file.
# ============================================================


# --- Database (Prisma Postgres) -----------------------------
# Postgres connection string. Required.
# Format: postgres://<user>:<pwd>@<host>:<port>/<db>?sslmode=require
DATABASE_URL=""


# --- NextAuth -----------------------------------------------
# JWT signing secret. Generate a fresh one with:
#   openssl rand -base64 32
# Cross-machine note: if two dev machines hit the same DB but
# use different AUTH_SECRETs, sessions won't transfer between
# them. Keep this the same on machines you want to share login
# state across.
AUTH_SECRET=""


# --- Google OAuth -------------------------------------------
# Get these from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# --- Anthropic (optional) -----------------------------------
# Required only if you want the /dashboard/quick-add AI-parse
# feature. Without it that one route returns 500; the rest of
# the app works fine.
# ANTHROPIC_API_KEY=""


# --- Custom domain feature ----------------------------------
# Vercel API token (Account Settings -> Tokens) used to attach
# user domains to this project from /dashboard/domain.
VERCEL_TOKEN=""
# Project ID from Vercel project settings (prj_...).
VERCEL_PROJECT_ID=""
# Only needed if the project lives under a team scope.
# VERCEL_TEAM_ID=""
# Host of the main app (no scheme). Requests on any other host
# are treated as bound custom domains; non-public paths on them
# redirect here.
NEXT_PUBLIC_APP_HOST="my-personal-website.vercel.app"
